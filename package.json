{
  "name": "canvas-mcp",
  "version": "2.0.0-alpha.1",
  "description": "Canvas LMS context and capability maps for MCP clients and CLI agents",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
    "start:http": "node dist/http.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm test",
    "inventory": "python3 scripts/inventory_canvas.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "dotenv": "^16.4.5",
    "linkedom": "^0.18.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aadi-FTC-12868/canvas-mcp.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "canvas-mcp": "dist/index.js",
    "canvas": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "integrations",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module"
}
